"""Native ttnn stub for `vocoder_hifi_gan` (SeamlessM4THifiGan) — the
full vocoder network (conv_pre + 5 ConvTranspose1d upsamplers + 15
residual blocks of 6 Conv1d each + conv_post). Its leaf sibling
`hifi_gan_residual_block` is already graduated; this parent stays
mixed-execution."""
from __future__ import annotations
import torch
import ttnn
import transformers

HF_MODEL_ID = 'facebook/hf-seamless-m4t-large'
_CANDIDATE_SUBMODULE_PATHS = ['vocoder.hifi_gan']


def _resolve(obj, dotted):
    cur = obj
    for tok in dotted.replace("[", ".").replace("]", "").split("."):
        if tok == "":
            continue
        if tok.isdigit():
            cur = cur[int(tok)]
        else:
            cur = getattr(cur, tok)
    return cur


class VocoderHifiGan:
    def __init__(self, device, torch_module):
        self.device = device
        self._torch_module = torch_module

    def __call__(self, hidden_states, *args, **kwargs):
        # ~100 Conv1d/ConvTranspose1d layers — not one-shot portable.
        # Sibling `hifi_gan_residual_block` is already graduated.
        raise NotImplementedError(
            "vocoder_hifi_gan is the full HiFi-GAN vocoder; graduate via "
            "hifi_gan_residual_block sibling + conv_pre/upsampler/post."
        )


def build(device, torch_module):
    return VocoderHifiGan(device, torch_module)


_instance = None


def vocoder_hifi_gan(*args, **kwargs):
    global _instance
    if _instance is None:
        model = transformers.AutoModel.from_pretrained(HF_MODEL_ID, trust_remote_code=True, torch_dtype="bfloat16", low_cpu_mem_usage=True)
        model.eval()
        torch_sub = None
        for path in _CANDIDATE_SUBMODULE_PATHS:
            try:
                torch_sub = _resolve(model, path)
                break
            except (AttributeError, IndexError, KeyError, TypeError):
                continue
        if torch_sub is None:
            raise RuntimeError('partial-stub: could not resolve `vocoder_hifi_gan`')
        _instance = build(ttnn.open_device(device_id=0), torch_sub)
    return _instance(*args, **kwargs)
