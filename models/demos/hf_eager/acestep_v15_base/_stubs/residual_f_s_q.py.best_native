Op counts: total=4  op-REUSE=4  op-ADAPT=0  op-NEW=0"""
from __future__ import annotations
import torch
import ttnn
import transformers

HF_MODEL_ID = 'ACE-Step/acestep-v15-base'
_CANDIDATE_SUBMODULE_PATHS = ['tokenizer.quantizer']

def _log_runtime_fallback(helper, kind, reason):
    """Append a structured CPU-fallback event for the planner reporter.

    Best-effort; never raises and never blocks the test. Writes to
    `<demo_dir>/_runtime_fallbacks.jsonl` (or the path in env
    TT_HW_PLANNER_RUNTIME_FALLBACK_LOG). The planner truncates this file
    before each pytest invocation and consumes it afterwards.
    """
    try:
        import sys as _sys, json as _json, os as _os, time as _time
        from pathlib import Path as _Path
        _sys.stderr.write("[%s_CPU_FALLBACK] %s: %s\n" % (kind.upper(), helper, reason))
        log_env = _os.environ.get("TT_HW_PLANNER_RUNTIME_FALLBACK_LOG")
        if log_env:
            log_path = _Path(log_env)
        else:
            # _stubs/<safe>.py  ->  demo_dir = parents[1]
            log_path = _Path(__file__).resolve().parents[1] / "_runtime_fallbacks.jsonl"
        log_path.parent.mkdir(parents=True, exist_ok=True)
        ev = {
            "component": _Path(__file__).stem,
            "helper": helper,
            "kind": kind,
            "reason": reason,
            "ts": _time.time(),
        }
        with log_path.open("a") as f:
            f.write(_json.dumps(ev) + "\n")
    except Exception:
        pass


_LLM_GAPS = [
    {'name': 'layers.0.project_in', 'class': 'Identity', 'notes': ''},
    {'name': 'layers.0.project_out', 'class': 'Identity', 'notes': ''},
]

def _resolve(obj, dotted):
    cur = obj
    for tok in dotted.replace("[", ".").replace("]", "").split("."):
        if tok == "":
            continue
        if tok.isdigit():
            cur = cur[int(tok)]
        else:
            cur = getattr(cur, tok)
    return cur

def _coerce_to_torch(x):
    try:
        import ttnn as _ttnn
        if isinstance(x, _ttnn.Tensor):
            import torch as _torch
            t = _ttnn.to_torch(x)
            # Bug Y fix (2026-05-23 live-run sam2-hiera-tiny)
            if t.is_floating_point():
                if t.dtype != _torch.float32:
                    t = t.to(_torch.float32)
            elif t.dtype != _torch.bool:
                t = t.to(_torch.long)
            return t
    except Exception:
        pass
    if isinstance(x, tuple):
        return tuple(_coerce_to_torch(e) for e in x)
    if isinstance(x, list):
        return [_coerce_to_torch(e) for e in x]
    if isinstance(x, dict):
        return {k: _coerce_to_torch(v) for k, v in x.items()}
    return x

class ResidualFSQ:
    def __init__(self, device, torch_module):
        self.device = device
        self._torch_module = torch_module
        sd = torch_module.state_dict()
        # op-REUSE: project_in  (Linear 2048 -> 6, bias=True)
        self.w_project_in_weight = ttnn.from_torch(sd['project_in.weight'].T.contiguous(), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)
        self.w_project_in_bias = ttnn.from_torch(sd['project_in.bias'].reshape(1, -1), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)

        # op-REUSE: project_out  (Linear 6 -> 2048, bias=True)
        self.w_project_out_weight = ttnn.from_torch(sd['project_out.weight'].T.contiguous(), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)
        self.w_project_out_bias = ttnn.from_torch(sd['project_out.bias'].reshape(1, -1), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)

        # FSQ quantization constants from layers[0] (num_quantizers=1)
        fsq_layer = torch_module.layers[0]
        _levels = fsq_layer._levels.detach().to(torch.float32).reshape(1, 1, -1)
        _basis = fsq_layer._basis.detach().to(torch.float32).reshape(1, 1, -1)
        _a = (_levels - 1.0) / 2.0
        _b = _a + 0.5
        _s = 2.0 / (_levels - 1.0)

        self.w_a = ttnn.from_torch(_a, dtype=ttnn.float32, layout=ttnn.TILE_LAYOUT, device=device)
        self.w_b = ttnn.from_torch(_b, dtype=ttnn.float32, layout=ttnn.TILE_LAYOUT, device=device)
        self.w_s = ttnn.from_torch(_s, dtype=ttnn.float32, layout=ttnn.TILE_LAYOUT, device=device)
        self.w_basis = ttnn.from_torch(_basis, dtype=ttnn.float32, layout=ttnn.TILE_LAYOUT, device=device)

    def _apply_project_in(self, x):
        return ttnn.linear(x, self.w_project_in_weight, bias=self.w_project_in_bias)

    def _apply_project_out(self, x):
        return ttnn.linear(x, self.w_project_out_weight, bias=self.w_project_out_bias)

    def __call__(self, *args, **kwargs):
        x = args[0] if args else kwargs.get('z', None)

        # Project down to codebook dimension (2048 -> 6)
        z = self._apply_project_in(x)

        # FSQ quantization (symmetry-preserving bound with hard clamp)
        # Do arithmetic in float32 to match HF reference and prevent
        # rounding from crossing floor() decision boundaries
        z = ttnn.typecast(z, ttnn.float32)
        c = ttnn.clamp(z, -1.0, 1.0)

        # bracket = floor((L-1)*(c+1)/2 + 0.5) = floor(a*c + b)
        bracket = ttnn.multiply(c, self.w_a)
        bracket = ttnn.add(bracket, self.w_b)
        bracket = ttnn.floor(bracket)

        # codes = (2/(L-1)) * bracket - 1 = s*bracket - 1
        codes = ttnn.multiply(bracket, self.w_s)
        codes = ttnn.subtract(codes, 1.0)

        # indices = round(sum over last dim of bracket * basis)
        # Reduce to (B, N) then unsqueeze to (B, N, 1) to match output contract
        weighted = ttnn.multiply(bracket, self.w_basis)
        idx = ttnn.sum(weighted, dim=-1)
        idx = ttnn.round(idx)
        idx = ttnn.typecast(idx, ttnn.int32)
        idx = ttnn.unsqueeze(idx, dim=-1)

        # Project back to output dimension (6 -> 2048)
        reconstructed = self._apply_project_out(codes)

        return (reconstructed, idx)

def build(device, torch_module):
    return ResidualFSQ(device, torch_module)

_instance = None

def residual_f_s_q(*args, **kwargs):
    global _instance
    if _instance is None:
        model = transformers.AutoModel.from_pretrained(HF_MODEL_ID, trust_remote_code=True, torch_dtype="bfloat16", low_cpu_mem_usage=True)
        model.eval()
        torch_sub = None
        for path in _CANDIDATE_SUBMODULE_PATHS:
            try:
                torch_sub = _resolve(model, path)
                break
            except (AttributeError, IndexError, KeyError, TypeError):
                continue
        if torch_sub is None:
            raise RuntimeError('partial-stub: could not resolve `residual_f_s_q`')
        _instance = build(ttnn.open_device(device_id=0), torch_sub)
    return _instance(*args, **kwargs)
