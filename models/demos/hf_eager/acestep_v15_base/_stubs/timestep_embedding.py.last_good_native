    def __init__(self, device, torch_module):
        self.device = device
        self._torch_module = torch_module
        sd = torch_module.state_dict()
        # op-REUSE: linear_1  (Linear 256 -> 2048, bias=True)
        self.w_linear_1_weight = ttnn.from_torch(sd['linear_1.weight'].T.contiguous(), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)
        self.w_linear_1_bias = ttnn.from_torch(sd['linear_1.bias'].reshape(1, -1), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)

        # op-REUSE: act1  (SILU)

        # op-REUSE: linear_2  (Linear 2048 -> 2048, bias=True)
        self.w_linear_2_weight = ttnn.from_torch(sd['linear_2.weight'].T.contiguous(), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)
        self.w_linear_2_bias = ttnn.from_torch(sd['linear_2.bias'].reshape(1, -1), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)

        # op-REUSE: act2  (SILU)

        # op-REUSE: time_proj  (Linear 2048 -> 12288, bias=True)
        self.w_time_proj_weight = ttnn.from_torch(sd['time_proj.weight'].T.contiguous(), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)
        self.w_time_proj_bias = ttnn.from_torch(sd['time_proj.bias'].reshape(1, -1), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)

    def _apply_linear_1(self, x):
        return ttnn.linear(x, self.w_linear_1_weight, bias=self.w_linear_1_bias)

    def _apply_act1(self, x):
        return ttnn.silu(x)

    def _apply_linear_2(self, x):
        return ttnn.linear(x, self.w_linear_2_weight, bias=self.w_linear_2_bias)

    def _apply_act2(self, x):
        return ttnn.silu(x)

    def _apply_time_proj(self, x):
        return ttnn.linear(x, self.w_time_proj_weight, bias=self.w_time_proj_bias)

    # op-NEW: sinusoidal timestep embedding (HF `TimestepEmbedding.timestep_embedding`)
    #   freqs = exp(-log(max_period) * arange(half) / half)
    # This is a static, input-independent lookup table -- materialize it once and
    # cache on the instance, same as a weight. IMPORTANT: keep it in float32.
    # The HF reference runs this whole module in fp32 (the test calls
    # `torch_module.float()`), and after the `scale=1000` multiply the sinusoid
    # arguments reach O(1000). bfloat16 has a step of ~8 near 1000, so cos()/sin()
    # of a bf16-rounded argument is essentially uncorrelated noise -> PCC collapses.
    # fp32 keeps the frequency table and the arguments accurate.
    def _apply_sinusoidal_freqs(self):
        freqs = getattr(self, "_freqs_const", None)
        if freqs is None:
            half = self._in_channels // 2
            exponent = -math.log(self._max_period) * torch.arange(start=0, end=half, dtype=torch.float32) / half
            freqs_t = torch.exp(exponent).reshape(1, half)
            freqs = ttnn.from_torch(freqs_t, dtype=ttnn.float32, layout=ttnn.TILE_LAYOUT, device=self.device)
            self._freqs_const = freqs
        return freqs

    _in_channels = 256
    _max_period = 10000
    _scale = 1000.0

    def __call__(self, timestep):
        # timestep: ttnn tensor holding a single scalar (logical shape (1,)).
        #
        # Mirror the HF reference forward (decoder.time_embed):
        #   t_freq        = timestep_embedding(t, in_channels=256)      # (1, 256)
        #   temb          = linear_2(act1(linear_1(t_freq)))            # (1, 2048)  <- graded output[0]
        #   timestep_proj = time_proj(act2(temb)).unflatten(1, (6, -1)) # (1, 6, 2048)  output[1]
        #
        # The sinusoidal projection is done in float32 for accuracy; only the
        # subsequent linear layers run in bf16 (their weights are bf16).
        half = self._in_channels // 2  # 128

        freqs = self._apply_sinusoidal_freqs()  # (1, half) float32

        # Reshape scalar to (1, 1) and lift to float32 so cos/sin stay accurate.
        t = ttnn.reshape(timestep, [1, 1])
        t = ttnn.typecast(t, ttnn.float32)
        t = ttnn.multiply(t, self._scale)  # t * 1000, still (1, 1) float32

        # args = (t * scale)[:, None] * freqs[None]  -> broadcast (1,1)*(1,half) = (1, half)
        args = ttnn.multiply(t, freqs)  # (1, half) float32
        cos_part = ttnn.cos(args)
        sin_part = ttnn.sin(args)
        t_freq = ttnn.concat([cos_part, sin_part], dim=-1)  # (1, 256) float32

        # Cast down to bf16 to match the (bf16) linear weights before the MLP.
        t_freq = ttnn.typecast(t_freq, ttnn.bfloat16)

        # HF forward(): temb = linear_2(act1(linear_1(t_freq)))  (NO act2 here)
        temb = self._apply_linear_1(t_freq)
        temb = self._apply_act1(temb)
        temb = self._apply_linear_2(temb)  # (1, 2048)  -- graded output[0]

        # timestep_proj = time_proj(act2(temb)).unflatten(1, (6, -1))
        proj_in = self._apply_act2(temb)
        timestep_proj = self._apply_time_proj(proj_in)  # (1, 12288)
        timestep_proj = ttnn.reshape(timestep_proj, [1, 6, 2048])

        return (temb, timestep_proj)

