    def _apply_layers_23_self_attn_o_proj(self, x):
        return self._lin(x, self.w_layers_23_self_attn_o_proj_weight)

    def _apply_layers_23_cross_attn_q_proj(self, x):
        return self._lin(x, self.w_layers_23_cross_attn_q_proj_weight)

    def _apply_layers_23_cross_attn_k_proj(self, x):
        return self._lin(x, self.w_layers_23_cross_attn_k_proj_weight)

    def _apply_layers_23_cross_attn_v_proj(self, x):
