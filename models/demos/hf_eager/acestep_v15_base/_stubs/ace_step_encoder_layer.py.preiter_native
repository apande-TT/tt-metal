        # op-REUSE: self_attn.v_proj  (Linear 2048 -> 1024, bias=False)
        self.w_self_attn_v_proj_weight = ttnn.from_torch(sd['self_attn.v_proj.weight'].T.contiguous(), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)

        # op-REUSE: self_attn.o_proj  (Linear 2048 -> 2048, bias=False)
        self.w_self_attn_o_proj_weight = ttnn.from_torch(sd['self_attn.o_proj.weight'].T.contiguous(), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)

        # op-REUSE: mlp.gate_proj  (Linear 2048 -> 6144, bias=False)
        self.w_mlp_gate_proj_weight = ttnn.from_torch(sd['mlp.gate_proj.weight'].T.contiguous(), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)

        # op-REUSE: mlp.up_proj  (Linear 2048 -> 6144, bias=False)
        self.w_mlp_up_proj_weight = ttnn.from_torch(sd['mlp.up_proj.weight'].T.contiguous(), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)

        # op-REUSE: mlp.down_proj  (Linear 6144 -> 2048, bias=False)
        self.w_mlp_down_proj_weight = ttnn.from_torch(sd['mlp.down_proj.weight'].T.contiguous(), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)

        # op-NEW: RMSNorm weights (input_layernorm / post_attention_layernorm operate
        # on the full hidden_size; q_norm / k_norm operate per-head on head_dim).
        self.w_input_layernorm_weight = ttnn.from_torch(sd['input_layernorm.weight'].contiguous(), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)
        self.w_post_attention_layernorm_weight = ttnn.from_torch(sd['post_attention_layernorm.weight'].contiguous(), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)
        self.w_self_attn_q_norm_weight = ttnn.from_torch(sd['self_attn.q_norm.weight'].contiguous(), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)
        self.w_self_attn_k_norm_weight = ttnn.from_torch(sd['self_attn.k_norm.weight'].contiguous(), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)

        # Attention shape config (mirrors AceStepAttention / Qwen3-style GQA attention).
        cfg = torch_module.config
        self._eps = cfg.rms_norm_eps
        self._num_heads = cfg.num_attention_heads
        self._num_kv_heads = cfg.num_key_value_heads
        self._head_dim = getattr(cfg, "head_dim", cfg.hidden_size // cfg.num_attention_heads)
        self._n_rep = self._num_heads // self._num_kv_heads
        self._scaling = self._head_dim ** -0.5

        # op-REUSE: mlp.act_fn  (SILU)

    def _apply_self_attn_q_proj(self, x):
        return ttnn.linear(x, self.w_self_attn_q_proj_weight)

    def _apply_self_attn_k_proj(self, x):
        return ttnn.linear(x, self.w_self_attn_k_proj_weight)

    def _apply_self_attn_v_proj(self, x):
        return ttnn.linear(x, self.w_self_attn_v_proj_weight)

    def _apply_self_attn_o_proj(self, x):
        return ttnn.linear(x, self.w_self_attn_o_proj_weight)

    def _apply_mlp_gate_proj(self, x):
        return ttnn.linear(x, self.w_mlp_gate_proj_weight)

    def _apply_mlp_up_proj(self, x):
        return ttnn.linear(x, self.w_mlp_up_proj_weight)

    def _apply_mlp_down_proj(self, x):
        return ttnn.linear(x, self.w_mlp_down_proj_weight)

    def _apply_mlp_act_fn(self, x):
        return ttnn.silu(x)

    def _apply_input_layernorm(self, x):
        return ttnn.rms_norm(x, epsilon=self._eps, weight=self.w_input_layernorm_weight)

    def _apply_post_attention_layernorm(self, x):
        return ttnn.rms_norm(x, epsilon=self._eps, weight=self.w_post_attention_layernorm_weight)

    def _apply_self_attn_q_norm(self, x):
        # x: (B, L, num_heads, head_dim) -- RMSNorm reduces over the last dim (head_dim),
        # matching Qwen3RMSNorm applied before the (1, 2) transpose in the HF reference.
        return ttnn.rms_norm(x, epsilon=self._eps, weight=self.w_self_attn_q_norm_weight)

    def _apply_self_attn_k_norm(self, x):
        return ttnn.rms_norm(x, epsilon=self._eps, weight=self.w_self_attn_k_norm_weight)

    def _apply_rotate_half(self, x):
        # rotate_half(x) = cat(-x2, x1) where x1, x2 are the two halves of the last dim.
        head_dim = x.shape[-1]
        half = head_dim // 2
        x1 = x[..., :half]
        x2 = x[..., half:]
        return ttnn.concat([ttnn.neg(x2), x1], dim=-1)

    def _apply_rope(self, x, cos, sin):
        return ttnn.add(ttnn.mul(x, cos), ttnn.mul(self._apply_rotate_half(x), sin))

    def __call__(
        self,
        hidden_states,
        position_embeddings,
        attention_mask=None,
        position_ids=None,
        output_attentions=False,
        **kwargs,
    ):
        bsz = hidden_states.shape[0]
        seq_len = hidden_states.shape[1]

        # --- Self-attention block ---
        residual = hidden_states
        normed = self._apply_input_layernorm(hidden_states)

        q = self._apply_self_attn_q_proj(normed)
        q = ttnn.reshape(q, (bsz, seq_len, self._num_heads, self._head_dim))
        q = self._apply_self_attn_q_norm(q)
        q = ttnn.transpose(q, 1, 2)  # (B, num_heads, L, head_dim)

        k = self._apply_self_attn_k_proj(normed)
        k = ttnn.reshape(k, (bsz, seq_len, self._num_kv_heads, self._head_dim))
        k = self._apply_self_attn_k_norm(k)
        k = ttnn.transpose(k, 1, 2)  # (B, num_kv_heads, L, head_dim)

        v = self._apply_self_attn_v_proj(normed)
        v = ttnn.reshape(v, (bsz, seq_len, self._num_kv_heads, self._head_dim))
        v = ttnn.transpose(v, 1, 2)  # (B, num_kv_heads, L, head_dim)

        cos, sin = position_embeddings
        cos = ttnn.reshape(cos, (bsz, 1, seq_len, self._head_dim))
        sin = ttnn.reshape(sin, (bsz, 1, seq_len, self._head_dim))
        # Materialize cos/sin across the head dimension explicitly rather than relying
        # on implicit elementwise broadcast (safer across ttnn binary-op kernels).
        cos_q = ttnn.repeat(cos, ttnn.Shape([1, self._num_heads, 1, 1]))
        sin_q = ttnn.repeat(sin, ttnn.Shape([1, self._num_heads, 1, 1]))
        cos_k = ttnn.repeat(cos, ttnn.Shape([1, self._num_kv_heads, 1, 1]))
        sin_k = ttnn.repeat(sin, ttnn.Shape([1, self._num_kv_heads, 1, 1]))

        q = self._apply_rope(q, cos_q, sin_q)
        k = self._apply_rope(k, cos_k, sin_k)

        # GQA: expand key/value heads to match query heads (repeat_kv == repeat_interleave).
        if self._n_rep > 1:
            k = ttnn.repeat_interleave(k, self._n_rep, dim=1)
            v = ttnn.repeat_interleave(v, self._n_rep, dim=1)

        attn_weights = ttnn.matmul(q, ttnn.transpose(k, 2, 3))  # (B, num_heads, L, L)
        attn_weights = ttnn.mul(attn_weights, self._scaling)
        if attention_mask is not None:
            mask = ttnn.repeat(attention_mask, ttnn.Shape([1, self._num_heads, 1, 1]))
            attn_weights = ttnn.add(attn_weights, mask)
        attn_weights = ttnn.softmax(attn_weights, dim=-1)

        attn_output = ttnn.matmul(attn_weights, v)  # (B, num_heads, L, head_dim)
        attn_output = ttnn.transpose(attn_output, 1, 2)  # (B, L, num_heads, head_dim)
        attn_output = ttnn.reshape(attn_output, (bsz, seq_len, self._num_heads * self._head_dim))
        attn_output = self._apply_self_attn_o_proj(attn_output)

        hidden_states = ttnn.add(residual, attn_output)

        # --- MLP block ---
        residual = hidden_states
        normed = self._apply_post_attention_layernorm(hidden_states)
        gate = self._apply_mlp_act_fn(self._apply_mlp_gate_proj(normed))
        up = self._apply_mlp_up_proj(normed)
        mlp_out = self._apply_mlp_down_proj(ttnn.mul(gate, up))
        hidden_states = ttnn.add(residual, mlp_out)

        outputs = (hidden_states,)
        if output_attentions:
            outputs = outputs + (attn_weights,)
        return outputs

