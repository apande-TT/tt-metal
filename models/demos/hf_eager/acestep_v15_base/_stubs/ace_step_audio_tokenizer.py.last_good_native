        # materialized once here exactly like every other constant weight.
        fsq_layer = torch_module.quantizer.layers[0]
        _levels = fsq_layer._levels.detach().to(torch.float32).reshape(1, 1, -1)
        _basis = fsq_layer._basis.detach().to(torch.float32).reshape(1, 1, -1)
        _a = (_levels - 1.0) / 2.0
        _b = _a + 0.5
        _s = 2.0 / (_levels - 1.0)
        self.w_fsq_a = ttnn.from_torch(_a, dtype=ttnn.float32, layout=ttnn.TILE_LAYOUT, device=device)
        self.w_fsq_b = ttnn.from_torch(_b, dtype=ttnn.float32, layout=ttnn.TILE_LAYOUT, device=device)
        self.w_fsq_s = ttnn.from_torch(_s, dtype=ttnn.float32, layout=ttnn.TILE_LAYOUT, device=device)
        self.w_fsq_basis = ttnn.from_torch(_basis, dtype=ttnn.float32, layout=ttnn.TILE_LAYOUT, device=device)

        # op-NEW (added): ResidualFSQ.forward applies a *soft* clamp to its
        # `project_in` output BEFORE any per-layer FSQ hard-clamp/quantize step:
        #   clamp_value = 1 + 1/(levels-1)         (per codebook dim)
        #   x = tanh(project_in_out / clamp_value) * clamp_value
        # This is distinct from (and runs before) the per-layer
        # `symmetry_preserving_bound(..., hard_clamp=True)` clamp(-1,1) already
        # implemented in __call__ below. Missing this step was the root cause of
        # the previous attempts' near-miss PCC (~0.98): almost every entry is
        # reshaped by the tanh, not just out-of-range ones. Read directly off the
        # ResidualFSQ module's own non-persistent buffer for exactness.
        _clamp_value = torch_module.quantizer.soft_clamp_input_value.detach().to(torch.float32).reshape(1, 1, -1)
        _inv_clamp_value = 1.0 / _clamp_value
        self.w_fsq_clamp_value = ttnn.from_torch(
            _clamp_value, dtype=ttnn.float32, layout=ttnn.TILE_LAYOUT, device=device
        )
        self.w_fsq_inv_clamp_value = ttnn.from_torch(
            _inv_clamp_value, dtype=ttnn.float32, layout=ttnn.TILE_LAYOUT, device=device
        )

        # Attention geometry / RoPE base for the attention_pooler's Qwen3-style
        # layers (config.num_attention_heads=16, num_key_value_heads=8,
        # head_dim=128, rope_theta=1e6 for this model).
        cfg = torch_module.config
        self._num_attention_heads = cfg.num_attention_heads
        self._num_key_value_heads = cfg.num_key_value_heads
        self._head_dim = getattr(cfg, "head_dim", cfg.hidden_size // cfg.num_attention_heads)
        self._rope_theta = cfg.rope_theta

    def _apply_audio_acoustic_proj(self, x):
        return ttnn.linear(x, self.w_audio_acoustic_proj_weight, bias=self.w_audio_acoustic_proj_bias)

    def _apply_attention_pooler_embed_tokens(self, x):
        return ttnn.linear(
            x, self.w_attention_pooler_embed_tokens_weight, bias=self.w_attention_pooler_embed_tokens_bias
        )

    def _apply_attention_pooler_layers_0_self_attn_q_proj(self, x):
        return ttnn.linear(x, self.w_attention_pooler_layers_0_self_attn_q_proj_weight)

    def _apply_attention_pooler_layers_0_self_attn_k_proj(self, x):
        return ttnn.linear(x, self.w_attention_pooler_layers_0_self_attn_k_proj_weight)

    def _apply_attention_pooler_layers_0_self_attn_v_proj(self, x):
        return ttnn.linear(x, self.w_attention_pooler_layers_0_self_attn_v_proj_weight)

    def _apply_attention_pooler_layers_0_self_attn_o_proj(self, x):
        return ttnn.linear(x, self.w_attention_pooler_layers_0_self_attn_o_proj_weight)

    def _apply_attention_pooler_layers_0_mlp_gate_proj(self, x):
        return ttnn.linear(x, self.w_attention_pooler_layers_0_mlp_gate_proj_weight)

    def _apply_attention_pooler_layers_0_mlp_up_proj(self, x):
        return ttnn.linear(x, self.w_attention_pooler_layers_0_mlp_up_proj_weight)

    def _apply_attention_pooler_layers_0_mlp_down_proj(self, x):
        return ttnn.linear(x, self.w_attention_pooler_layers_0_mlp_down_proj_weight)

    def _apply_attention_pooler_layers_0_mlp_act_fn(self, x):
        return ttnn.silu(x)

    def _apply_attention_pooler_layers_1_self_attn_q_proj(self, x):
        return ttnn.linear(x, self.w_attention_pooler_layers_1_self_attn_q_proj_weight)

    def _apply_attention_pooler_layers_1_self_attn_k_proj(self, x):
        return ttnn.linear(x, self.w_attention_pooler_layers_1_self_attn_k_proj_weight)

    def _apply_attention_pooler_layers_1_self_attn_v_proj(self, x):
        return ttnn.linear(x, self.w_attention_pooler_layers_1_self_attn_v_proj_weight)

    def _apply_attention_pooler_layers_1_self_attn_o_proj(self, x):
        return ttnn.linear(x, self.w_attention_pooler_layers_1_self_attn_o_proj_weight)

    def _apply_attention_pooler_layers_1_mlp_gate_proj(self, x):
        return ttnn.linear(x, self.w_attention_pooler_layers_1_mlp_gate_proj_weight)

    def _apply_attention_pooler_layers_1_mlp_up_proj(self, x):
        return ttnn.linear(x, self.w_attention_pooler_layers_1_mlp_up_proj_weight)

    def _apply_attention_pooler_layers_1_mlp_down_proj(self, x):
        return ttnn.linear(x, self.w_attention_pooler_layers_1_mlp_down_proj_weight)

    def _apply_attention_pooler_layers_1_mlp_act_fn(self, x):
        return ttnn.silu(x)

    def _apply_quantizer_project_in(self, x):
        return ttnn.linear(x, self.w_quantizer_project_in_weight, bias=self.w_quantizer_project_in_bias)

    def _apply_quantizer_project_out(self, x):
        return ttnn.linear(x, self.w_quantizer_project_out_weight, bias=self.w_quantizer_project_out_bias)

    def _apply_rms_norm(self, x, weight, eps=None):
        if eps is None:
            eps = self.w_rms_norm_eps
        x_sq = ttnn.mul(x, x)
        mean_sq = ttnn.mean(x_sq, dim=-1, keepdim=True)
        mean_sq_eps = ttnn.add(mean_sq, eps)
        rms = ttnn.sqrt(mean_sq_eps)
        rms_inv = ttnn.reciprocal(rms)
        normalized = ttnn.mul(x, rms_inv)
        return ttnn.mul(normalized, weight)

    def _compute_rope_cos_sin(self, seq_len, head_dim):
        inv_freq = 1.0 / (self._rope_theta ** (torch.arange(0, head_dim, 2, dtype=torch.float32) / head_dim))
        positions = torch.arange(seq_len, dtype=torch.float32)
        freqs = torch.outer(positions, inv_freq)
        emb = torch.cat([freqs, freqs], dim=-1)
        cos = emb.cos().reshape(1, 1, seq_len, head_dim)
        sin = emb.sin().reshape(1, 1, seq_len, head_dim)
        cos_t = ttnn.from_torch(
            cos.to(torch.bfloat16), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=self.device
        )
        sin_t = ttnn.from_torch(
            sin.to(torch.bfloat16), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=self.device
        )
        return cos_t, sin_t

    def _rotate_half(self, x, head_dim):
        half = head_dim // 2
        x1 = ttnn.slice(x, [0, 0, 0, 0], [x.shape[0], x.shape[1], x.shape[2], half])
        x2 = ttnn.slice(x, [0, 0, 0, half], [x.shape[0], x.shape[1], x.shape[2], head_dim])
        return ttnn.concat([ttnn.neg(x2), x1], dim=-1)

    def _apply_rope(self, x, cos, sin, head_dim):
        return ttnn.add(ttnn.mul(x, cos), ttnn.mul(self._rotate_half(x, head_dim), sin))

    # ---- float32 fidelity helpers -------------------------------------------
    # The PCC reference is executed in float32 (the test upcasts the bf16 HF
    # module via `.float()`), and the weights we materialized are the exact
    # same bf16 values upcast losslessly back to fp32 here. Running the whole
    # pooler+quantizer in fp32 therefore reproduces the reference to fp32
    # rounding. That precision is REQUIRED: the FSQ `floor()` snaps the pooled
    # vector onto a discrete grid, so a bf16-sized activation error near a bin
    # boundary flips a code and craters PCC (prior all-bf16 attempt: ~0.98).
    #
    # 2026-07-03 fix (this iter): fp32 *tensors* are not sufficient on their
    # own. `ttnn.linear`/`ttnn.matmul` default to MathFidelity.LoFi, i.e. the
    # matmul multiplies bf16-truncated mantissas and accumulates in a low
    # precision dest -- so even with fp32 activations the projection outputs
    # carry ~bf16-sized error. That error compounds across the ~10 stacked
    # matmuls of the pooler, drifts the pre-quantization activation across FSQ
    # floor() bin boundaries, and the dense project_out (6->2048) then smears
    # each single flipped code across an entire 2048-wide output row -- exactly
    # the ~0.9828 near-miss seen previously. The fix is to run every matmul at
    # HiFi4 with fp32 dest accumulation (`_mm_cfg`), which reproduces a genuine
    # fp32 matmul on device and stops the boundary flips.
    def _mm_cfg(self):
        return ttnn.WormholeComputeKernelConfig(
            math_fidelity=ttnn.MathFidelity.HiFi4,
            math_approx_mode=False,
            fp32_dest_acc_en=True,
            packer_l1_acc=True,
        )

    def _lin_f32(self, x, weight, bias=None, compute_kernel_config=None):
        wf = ttnn.typecast(weight, ttnn.float32)
        if bias is not None:
            bf = ttnn.typecast(bias, ttnn.float32)
            return ttnn.linear(x, wf, bias=bf, compute_kernel_config=compute_kernel_config)
        return ttnn.linear(x, wf, compute_kernel_config=compute_kernel_config)

    def _rms_norm_f32(self, x, weight):
        # x is float32; `weight` is a bf16 tensor already shaped to broadcast
        # over x's last (normalized) dim. Matches Qwen3RMSNorm (fp32 variance).
        var = ttnn.mean(ttnn.mul(x, x), dim=-1, keepdim=True)
        var = ttnn.add(var, 1e-6)
        inv = ttnn.rsqrt(var)
        xn = ttnn.mul(x, inv)
        return ttnn.mul(xn, ttnn.typecast(weight, ttnn.float32))

    def _rope_tables_f32(self, seq_len, head_dim):
        inv_freq = 1.0 / (self._rope_theta ** (torch.arange(0, head_dim, 2, dtype=torch.float32) / head_dim))
        positions = torch.arange(seq_len, dtype=torch.float32)
        freqs = torch.outer(positions, inv_freq)
        emb = torch.cat([freqs, freqs], dim=-1)
        cos = emb.cos().reshape(1, 1, seq_len, head_dim)
        sin = emb.sin().reshape(1, 1, seq_len, head_dim)
        cos_t = ttnn.from_torch(cos, dtype=ttnn.float32, layout=ttnn.TILE_LAYOUT, device=self.device)
        sin_t = ttnn.from_torch(sin, dtype=ttnn.float32, layout=ttnn.TILE_LAYOUT, device=self.device)
        return cos_t, sin_t

    def __call__(self, hidden_states):
        # hidden_states: (B, T, P, D_in) where P = pool_window_size (5) and
        # D_in = audio_acoustic_hidden_dim (64).
        B, T, P, D_in = tuple(hidden_states.shape)
        hidden_size = 2048
        num_heads = self._num_attention_heads
        num_kv_heads = self._num_key_value_heads
        head_dim = self._head_dim
        n_rep = num_heads // num_kv_heads
        scaling = head_dim**-0.5

        # HiFi4 + fp32-dest-accum matmul config. Applied to EVERY linear/matmul
        # in the forward path: the FSQ floor() at the tail is a step function,
        # so the pre-quantization activation must match the fp32 reference to
        # well within a bin width or codes flip. Default LoFi matmul carries
        # ~bf16 error that compounds over the stacked projections and crosses
        # those bin boundaries -- HiFi4 with fp32 accumulation removes it.
        mm = self._mm_cfg()

        # Run the entire pooler + quantizer in float32 (see the fidelity-helper
        # comment above): the reference runs in fp32 and the weights match
        # bit-for-bit, so fp32 activations avoid the bf16 floor()-boundary
        # flips that limited the earlier bf16 port to ~0.98 PCC.
        x = ttnn.typecast(hidden_states, ttnn.float32)

        # ---- audio_acoustic_proj: 64 -> 2048, elementwise over (B,T,P) ----
        x = ttnn.reshape(x, (B * T * P, D_in))
        x = self._lin_f32(x, self.w_audio_acoustic_proj_weight, self.w_audio_acoustic_proj_bias, mm)

        BT = B * T
        x = ttnn.reshape(x, (BT, P, hidden_size))

        # ---- attention_pooler: embed patches, prepend CLS-like special token ----
        x = self._lin_f32(x, self.w_attention_pooler_embed_tokens_weight, self.w_attention_pooler_embed_tokens_bias, mm)

        special = ttnn.typecast(self.w_attention_pooler_special_token, ttnn.float32)
        special = ttnn.repeat(special, ttnn.Shape([BT, 1, 1]))
        x = ttnn.concat([special, x], dim=1)
        S = P + 1

        # Shared rotary tables for this forward pass (identical across layers).
        # cos/sin come out (1, 1, S, head_dim); replicate across the head dim so
        # the elementwise RoPE mul/add broadcasts cleanly.
        cos, sin = self._rope_tables_f32(S, head_dim)
        cos_q = ttnn.repeat(cos, ttnn.Shape([1, num_heads, 1, 1]))
        sin_q = ttnn.repeat(sin, ttnn.Shape([1, num_heads, 1, 1]))
        cos_k = ttnn.repeat(cos, ttnn.Shape([1, num_kv_heads, 1, 1]))
        sin_k = ttnn.repeat(sin, ttnn.Shape([1, num_kv_heads, 1, 1]))

        # q_norm/k_norm are RMSNorm applied per-head (on head_dim), so reshape
        # their (1, hidden_size)-flattened weights down to (1, 1, 1, head_dim)
        # once up front instead of relying on cross-rank broadcasting.
        q_norm_w = [
            ttnn.reshape(self.w_attention_pooler_layers_0_self_attn_q_norm_weight, (1, 1, 1, head_dim)),
            ttnn.reshape(self.w_attention_pooler_layers_1_self_attn_q_norm_weight, (1, 1, 1, head_dim)),
        ]
        k_norm_w = [
            ttnn.reshape(self.w_attention_pooler_layers_0_self_attn_k_norm_weight, (1, 1, 1, head_dim)),
            ttnn.reshape(self.w_attention_pooler_layers_1_self_attn_k_norm_weight, (1, 1, 1, head_dim)),
        ]

        # input/post/final RMSNorm weights: reshape (1, hidden) -> (1, 1, hidden)
        # so the norm broadcasts cleanly over the (BT, S, hidden) activations.
        input_ln_w = [
            ttnn.reshape(self.w_attention_pooler_layers_0_input_layernorm_weight, (1, 1, hidden_size)),
            ttnn.reshape(self.w_attention_pooler_layers_1_input_layernorm_weight, (1, 1, hidden_size)),
        ]
        post_ln_w = [
            ttnn.reshape(self.w_attention_pooler_layers_0_post_attention_layernorm_weight, (1, 1, hidden_size)),
            ttnn.reshape(self.w_attention_pooler_layers_1_post_attention_layernorm_weight, (1, 1, hidden_size)),
        ]

        layer_weights = [
            {
                "input_ln": input_ln_w[0],
                "q": self.w_attention_pooler_layers_0_self_attn_q_proj_weight,
                "k": self.w_attention_pooler_layers_0_self_attn_k_proj_weight,
                "v": self.w_attention_pooler_layers_0_self_attn_v_proj_weight,
                "o": self.w_attention_pooler_layers_0_self_attn_o_proj_weight,
                "q_norm": q_norm_w[0],
                "k_norm": k_norm_w[0],
                "post_ln": post_ln_w[0],
                "gate": self.w_attention_pooler_layers_0_mlp_gate_proj_weight,
                "up": self.w_attention_pooler_layers_0_mlp_up_proj_weight,
                "down": self.w_attention_pooler_layers_0_mlp_down_proj_weight,
            },
            {
                "input_ln": input_ln_w[1],
                "q": self.w_attention_pooler_layers_1_self_attn_q_proj_weight,
                "k": self.w_attention_pooler_layers_1_self_attn_k_proj_weight,
                "v": self.w_attention_pooler_layers_1_self_attn_v_proj_weight,
                "o": self.w_attention_pooler_layers_1_self_attn_o_proj_weight,
                "q_norm": q_norm_w[1],
                "k_norm": k_norm_w[1],
                "post_ln": post_ln_w[1],
                "gate": self.w_attention_pooler_layers_1_mlp_gate_proj_weight,
                "up": self.w_attention_pooler_layers_1_mlp_up_proj_weight,
                "down": self.w_attention_pooler_layers_1_mlp_down_proj_weight,
            },
        ]

        for lw in layer_weights:
            residual = x
            h = self._rms_norm_f32(x, lw["input_ln"])

            # Qwen3-style attention: q_norm/k_norm are applied per-head (on
            # head_dim, AFTER splitting heads, BEFORE the (1,2) transpose).
            q = ttnn.reshape(self._lin_f32(h, lw["q"], None, mm), (BT, S, num_heads, head_dim))
            q = self._rms_norm_f32(q, lw["q_norm"])
            q = ttnn.transpose(q, 1, 2)  # (BT, num_heads, S, head_dim)

            k = ttnn.reshape(self._lin_f32(h, lw["k"], None, mm), (BT, S, num_kv_heads, head_dim))
            k = self._rms_norm_f32(k, lw["k_norm"])
            k = ttnn.transpose(k, 1, 2)  # (BT, num_kv_heads, S, head_dim)

            v = ttnn.reshape(self._lin_f32(h, lw["v"], None, mm), (BT, S, num_kv_heads, head_dim))
            v = ttnn.transpose(v, 1, 2)  # (BT, num_kv_heads, S, head_dim)

            q = self._apply_rope(q, cos_q, sin_q, head_dim)
            k = self._apply_rope(k, cos_k, sin_k, head_dim)

            # GQA: expand KV heads to match query heads (repeat_kv ==
            # repeat_interleave along the head dim).
            if n_rep > 1:
                k = ttnn.repeat_interleave(k, n_rep, dim=1)
                v = ttnn.repeat_interleave(v, n_rep, dim=1)

            # Bidirectional (non-causal) attention. S = pool_window_size + 1 = 6
            # is far smaller than sliding_window (128), so the sliding-window
            # mask is a no-op and there is no padding mask.
            attn_weights = ttnn.matmul(q, ttnn.transpose(k, 2, 3), compute_kernel_config=mm)  # (BT, num_heads, S, S)
            attn_weights = ttnn.mul(attn_weights, scaling)
            attn_weights = ttnn.softmax(attn_weights, dim=-1)

            attn_out = ttnn.matmul(attn_weights, v, compute_kernel_config=mm)  # (BT, num_heads, S, head_dim)
            attn_out = ttnn.transpose(attn_out, 1, 2)  # (BT, S, num_heads, head_dim)
            attn_out = ttnn.reshape(attn_out, (BT, S, num_heads * head_dim))
            attn_out = self._lin_f32(attn_out, lw["o"], None, mm)

            x = ttnn.add(residual, attn_out)

            # Qwen3MLP: down_proj(silu(gate_proj(x)) * up_proj(x))
            residual = x
            h = self._rms_norm_f32(x, lw["post_ln"])
            gate = ttnn.silu(self._lin_f32(h, lw["gate"], None, mm))
            up = self._lin_f32(h, lw["up"], None, mm)
            mlp_out = self._lin_f32(ttnn.mul(gate, up), lw["down"], None, mm)
            x = ttnn.add(residual, mlp_out)

        x = self._rms_norm_f32(x, ttnn.reshape(self.w_attention_pooler_norm_weight, (1, 1, hidden_size)))

        # Extract the special (CLS) token output at position 0 -> pooled representation.
        cls = ttnn.slice(x, [0, 0, 0], [x.shape[0], 1, x.shape[2]])
        pooled = ttnn.reshape(cls, (B, T, hidden_size))

        # ---- quantizer: ResidualFSQ (project_in -> soft-clamp -> FSQ -> project_out) ----
        # num_quantizers == 1 and scale == levels**0 == 1, so ResidualFSQ
        # collapses to a single FSQ layer with no residual bookkeeping.
        z = self._lin_f32(pooled, self.w_quantizer_project_in_weight, self.w_quantizer_project_in_bias, mm)

        # Everything downstream is already float32 (pooled -> fp32 linear -> z).

        # ResidualFSQ.forward applies a soft (tanh-based) clamp to the
        # project_in output BEFORE the per-layer FSQ hard-clamp/quantize step:
        #   x = tanh(z / clamp_value) * clamp_value,  clamp_value = 1 + 1/(L-1)
        # This reshapes essentially every value (not just out-of-range ones),
        # so it must run before the hard clamp(-1, 1) below.
        z = ttnn.mul(z, self.w_fsq_inv_clamp_value)
        z = ttnn.tanh(z)
        z = ttnn.mul(z, self.w_fsq_clamp_value)

        # bracket = floor((L-1)*(c+1)/2 + 0.5) = floor(a*c + b), c = clamp(z,-1,1)
        c = ttnn.clamp(z, -1.0, 1.0)
        bracket = ttnn.multiply(c, self.w_fsq_a)
        bracket = ttnn.add(bracket, self.w_fsq_b)
        bracket = ttnn.floor(bracket)

        # codes = (2/(L-1)) * bracket - 1 = s*bracket - 1
        codes = ttnn.multiply(bracket, self.w_fsq_s)
        codes = ttnn.subtract(codes, 1.0)

        # indices = round(sum over last dim of bracket * basis) -> (B, T, 1)
        weighted = ttnn.multiply(bracket, self.w_fsq_basis)
        idx = ttnn.sum(weighted, dim=-1)
        idx = ttnn.round(idx)
        idx = ttnn.typecast(idx, ttnn.int32)
        idx = ttnn.unsqueeze(idx, dim=-1)

        quantized = self._lin_f32(codes, self.w_quantizer_project_out_weight, self.w_quantizer_project_out_bias, mm)

        return quantized, idx


def build(device, torch_module):
    return AceStepAudioTokenizer(device, torch_module)


_instance = None


def ace_step_audio_tokenizer(*args, **kwargs):
    global _instance
    if _instance is None:
        model = transformers.AutoModel.from_pretrained(
            HF_MODEL_ID, trust_remote_code=True, torch_dtype="bfloat16", low_cpu_mem_usage=True
        )
        model.eval()
        torch_sub = None
        for path in _CANDIDATE_SUBMODULE_PATHS:
            try:
                torch_sub = _resolve(model, path)
                break
            except (AttributeError, IndexError, KeyError, TypeError):
                continue
        if torch_sub is None:
            raise RuntimeError("partial-stub: could not resolve `ace_step_audio_tokenizer`")
        _instance = build(ttnn.open_device(device_id=0), torch_sub)
    return _instance(*args, **kwargs)
