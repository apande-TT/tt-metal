    def _apply_quantizer_project_in(self, x):
        return ttnn.linear(x, self.w_quantizer_project_in_weight, bias=self.w_quantizer_project_in_bias)

    def _apply_quantizer_project_out(self, x):
        return ttnn.linear(x, self.w_quantizer_project_out_weight, bias=self.w_quantizer_project_out_bias)

    def _apply_rms_norm(self, x, weight, eps=1e-6):
        x_sq = ttnn.mul(x, x)
        mean_sq = ttnn.mean(x_sq, dim=-1, keepdim=True)
        mean_sq_eps = ttnn.add(mean_sq, eps)
        rms = ttnn.sqrt(mean_sq_eps)
        rms_inv = ttnn.reciprocal(rms)
        normalized = ttnn.mul(x, rms_inv)
        return ttnn.mul(normalized, weight)

    def __call__(self, hidden_states):
        batch_size = hidden_states.shape[0]
        num_frames = hidden_states.shape[1]

        hidden_states = ttnn.reshape(hidden_states, (batch_size, num_frames * 5, 64))
        hidden_states = self._apply_audio_acoustic_proj(hidden_states)

        hidden_states = ttnn.reshape(hidden_states, (batch_size, num_frames, 5, 2048))
        hidden_states = ttnn.mean(hidden_states, dim=2)

        hidden_states = self._apply_attention_pooler_embed_tokens(hidden_states)
        hidden_states = self._apply_rms_norm(hidden_states, self.w_attention_pooler_norm_weight)

        for layer_idx in range(2):
            residual = hidden_states

            if layer_idx == 0:
                x_norm = self._apply_rms_norm(hidden_states, self.w_attention_pooler_layers_0_input_layernorm_weight)
                q = self._apply_attention_pooler_layers_0_self_attn_q_proj(x_norm)
                k = self._apply_attention_pooler_layers_0_self_attn_k_proj(x_norm)
                v = self._apply_attention_pooler_layers_0_self_attn_v_proj(x_norm)
                q_norm = self._apply_rms_norm(q, self.w_attention_pooler_layers_0_self_attn_q_norm_weight)
                k_norm = self._apply_rms_norm(k, self.w_attention_pooler_layers_0_self_attn_k_norm_weight)
            else:
                x_norm = self._apply_rms_norm(hidden_states, self.w_attention_pooler_layers_1_input_layernorm_weight)
                q = self._apply_attention_pooler_layers_1_self_attn_q_proj(x_norm)
                k = self._apply_attention_pooler_layers_1_self_attn_k_proj(x_norm)
                v = self._apply_attention_pooler_layers_1_self_attn_v_proj(x_norm)
                q_norm = self._apply_rms_norm(q, self.w_attention_pooler_layers_1_self_attn_q_norm_weight)
                k_norm = self._apply_rms_norm(k, self.w_attention_pooler_layers_1_self_attn_k_norm_weight)

            q_rot = ttnn.mul(q_norm, self.w_rotary_cos)
            k_rot = ttnn.mul(k_norm, self.w_rotary_cos)

            k_rot_t = ttnn.transpose(k_rot, -2, -1)
            scores = ttnn.matmul(q_rot, k_rot_t)
            scores = ttnn.mul(scores, 1.0 / math.sqrt(128))
            attn_weights = ttnn.softmax(scores, dim=-1)
            attn_out = ttnn.matmul(attn_weights, v)

            if layer_idx == 0:
                attn_out = self._apply_attention_pooler_layers_0_self_attn_o_proj(attn_out)
            else:
                attn_out = self._apply_attention_pooler_layers_1_self_attn_o_proj(attn_out)

            hidden_states = ttnn.add(residual, attn_out)

            residual2 = hidden_states
            if layer_idx == 0:
                x_norm = self._apply_rms_norm(hidden_states, self.w_attention_pooler_layers_0_post_attention_layernorm_weight)
                gate = self._apply_attention_pooler_layers_0_mlp_gate_proj(x_norm)
                up = self._apply_attention_pooler_layers_0_mlp_up_proj(x_norm)
                act = self._apply_attention_pooler_layers_0_mlp_act_fn(gate)
                mlp_out = ttnn.mul(act, up)
                mlp_out = self._apply_attention_pooler_layers_0_mlp_down_proj(mlp_out)
            else:
                x_norm = self._apply_rms_norm(hidden_states, self.w_attention_pooler_layers_1_post_attention_layernorm_weight)
                gate = self._apply_attention_pooler_layers_1_mlp_gate_proj(x_norm)
                up = self._apply_attention_pooler_layers_1_mlp_up_proj(x_norm)
                act = self._apply_attention_pooler_layers_1_mlp_act_fn(gate)
                mlp_out = ttnn.mul(act, up)
                mlp_out = self._apply_attention_pooler_layers_1_mlp_down_proj(mlp_out)

            hidden_states = ttnn.add(residual2, mlp_out)

        codes = self._apply_quantizer_project_in(hidden_states)

        codes_torch = ttnn.to_torch(codes).to(torch.float32)
        codes_idx = torch.argmax(codes_torch, dim=-1, keepdim=True).to(torch.int32)
        codes_idx = ttnn.from_torch(codes_idx, dtype=ttnn.int32, layout=ttnn.TILE_LAYOUT, device=self.device)

        quantized = self._apply_quantizer_project_out(codes)

        return quantized, codes_idx

def build(device, torch_module):
    return AceStepAudioTokenizer(device, torch_module)

_instance = None

def ace_step_audio_tokenizer(*args, **kwargs):
    global _instance
    if _instance is None:
        model = transformers.AutoModel.from_pretrained(HF_MODEL_ID, trust_remote_code=True, torch_dtype="bfloat16", low_cpu_mem_usage=True)
        model.eval()
        torch_sub = None
        for path in _CANDIDATE_SUBMODULE_PATHS:
            try:
                torch_sub = _resolve(model, path)
                break
            except (AttributeError, IndexError, KeyError, TypeError):
                continue
        if torch_sub is None:
            raise RuntimeError('partial-stub: could not resolve `ace_step_audio_tokenizer`')
        _instance = build(ttnn.open_device(device_id=0), torch_sub)
    return _instance(*args, **kwargs)
