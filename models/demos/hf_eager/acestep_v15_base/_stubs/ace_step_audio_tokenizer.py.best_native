        self.w_attention_pooler_layers_1_self_attn_k_norm_weight = ttnn.from_torch(sd['attention_pooler.layers.1.self_attn.k_norm.weight'].reshape(1, -1), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)
        self.w_attention_pooler_layers_1_post_attention_layernorm_weight = ttnn.from_torch(sd['attention_pooler.layers.1.post_attention_layernorm.weight'].reshape(1, -1), dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)

