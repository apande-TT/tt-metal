        # input_features: (1, num_mel_bins, T) -> conv stem -> +pos -> 32 encoder
        # layers (bidirectional) -> final LayerNorm. Returns last_hidden_state.
        x = args[0] if args else kwargs["input_features"]
        x = ttnn.transpose(x, 1, 2)  # (1, T, num_mel_bins)
        x = ttnn.gelu(self._conv1d(x, self._conv1, stride=1))
        x = ttnn.gelu(self._conv1d(x, self._conv2, stride=2))
        x = ttnn.add(x, self.embed_pos)  # + positional embedding
        for i in range(self.num_layers):
            x = self._encoder_layer(i, x)
        return self._apply_layer_norm(x)


