        self._conv1 = _load_conv("conv1")
        self._conv2 = _load_conv("conv2")

        # Full positional-embedding table added to all max_source_positions tokens.
        self.embed_pos = ttnn.from_torch(
            sd["embed_positions.weight"].reshape(1, sd["embed_positions.weight"].shape[0], -1),
            dtype=ttnn.bfloat16,
            layout=ttnn.TILE_LAYOUT,
            device=device,
        )

    def _conv1d(self, x, conv, stride):
        # x: (1, L, Cin) TILE bf16. Conv1d k=3, pad=1. Matmul the full input per
        # kernel tap, then shift/pad/accumulate the RESULTS in ROW_MAJOR (never
        # tilize an offset slice). out[o] = sum_t r_t[o + t - (K//2)].
        L = int(x.shape[1])
        taps = conv["taps"]
        K = conv["K"]
        pad = K // 2
        rs = [
            ttnn.to_layout(ttnn.matmul(x, w, compute_kernel_config=self.compute_kernel_config), ttnn.ROW_MAJOR_LAYOUT)
            for w in taps
        ]
        Cout = int(rs[0].shape[2])
        # Cache the (1,1,Cout) zero pad ONCE — a per-forward ttnn.from_torch is a host->device
        # write that TT_FATALs under trace capture (prefill trace-capturability). Built lazily on
        # the first forward (warmup), reused thereafter so the traced forward is host-op-free.
        _zc = getattr(self, "_conv_zero_cache", None)
        if _zc is None:
            _zc = self._conv_zero_cache = {}
        zero = _zc.get(Cout)
        if zero is None:
            zero = _zc[Cout] = ttnn.from_torch(
                torch.zeros(1, 1, Cout), dtype=ttnn.bfloat16, layout=ttnn.ROW_MAJOR_LAYOUT, device=self.device
            )
        acc = None
        for t in range(K):
            sh = t - pad  # result index = o + sh
            r = rs[t]
            if sh < 0:  # need r[o-1]: shift right, pad front
                n = -sh
                r = ttnn.concat([zero] * n + [ttnn.slice(r, [0, 0, 0], [1, L - n, Cout])], dim=1)
            elif sh > 0:  # need r[o+1]: shift left, pad back
                n = sh
                r = ttnn.concat([ttnn.slice(r, [0, n, 0], [1, L, Cout])] + [zero] * n, dim=1)
            acc = r if acc is None else ttnn.add(acc, r)
        out = ttnn.to_layout(acc, ttnn.TILE_LAYOUT)
        out = ttnn.add(out, conv["bias"])
        if stride > 1:
            out = ttnn.to_layout(out, ttnn.ROW_MAJOR_LAYOUT)
            out = ttnn.reshape(out, (1, L // stride, stride, Cout))
            out = ttnn.slice(out, [0, 0, 0, 0], [1, L // stride, 1, Cout])
            out = ttnn.reshape(out, (1, L // stride, Cout))
            out = ttnn.to_layout(out, ttnn.TILE_LAYOUT)
        return out

    def _to_heads(self, x):
        t = int(x.shape[1])
        x = ttnn.reshape(x, (1, t, self.num_heads, self.head_dim))
        return ttnn.transpose(x, 1, 2)

    def _encoder_layer(self, i, x):
        A = lambda name: getattr(self, f"_apply_layers_{i}_{name}")
        residual = x
        h = A("self_attn_layer_norm")(x)
        # VoxtralAttention: scaling applied to q (proj output), attention scaling=1.
        # datamove+attention-coherence: fused QKV proj -> single-kernel head split ->
        # fused FlashAttention-2 (bidirectional, no mask, scale folded in) -> head concat.
        qkv = ttnn.linear(h, self.w_qkv[i], bias=self.w_qkv_bias[i], compute_kernel_config=self.compute_kernel_config)
        qkv = ttnn.reshape(qkv, (1, 1, qkv.shape[1], qkv.shape[2]))  # cheap view -> [B,1,S,3*hidden]
        q, k, v = ttnn.experimental.nlp_create_qkv_heads(
            qkv, num_heads=self.num_heads, num_kv_heads=self.num_heads, transpose_k_heads=False
        )
        attn = ttnn.transformer.scaled_dot_product_attention(
            q, k, v, is_causal=False, scale=self.scaling,
            program_config=self.sdpa_program_config, compute_kernel_config=self.compute_kernel_config
        )
        attn = ttnn.experimental.nlp_concat_heads(attn)  # [1,H,S,D] -> [1,1,S,H*D]
        attn = ttnn.reshape(attn, (1, attn.shape[2], self.num_heads * self.head_dim))
        attn = A("self_attn_out_proj")(attn)
        x = ttnn.add(residual, attn)

        residual = x
        h = A("final_layer_norm")(x)
        # fc1/fc2 on bf8_b weights + LoFi (compute-bound at seq=1504). gelu fused into fc1.
        h = ttnn.linear(
            h, getattr(self, f"w_layers_{i}_fc1_weight"), bias=getattr(self, f"w_layers_{i}_fc1_bias"),
            compute_kernel_config=self.mm_compute_kernel_config, activation="gelu",
        )
        h = ttnn.linear(
            h, getattr(self, f"w_layers_{i}_fc2_weight"), bias=getattr(self, f"w_layers_{i}_fc2_bias"),
            compute_kernel_config=self.mm_compute_kernel_config,
        )
        return ttnn.add(residual, h)

