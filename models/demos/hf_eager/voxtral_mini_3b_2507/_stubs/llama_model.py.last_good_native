        # so the head-split can use ttnn.experimental.nlp_create_qkv_heads (single kernel,
        # no manual reshape+transpose relayout).
        self.w_qkv = []
        for i in range(self.num_layers):
            qw = sd[f"layers.{i}.self_attn.q_proj.weight"]  # (num_heads*head_dim, hidden)
            kw = sd[f"layers.{i}.self_attn.k_proj.weight"]  # (num_kv_heads*head_dim, hidden)
            vw = sd[f"layers.{i}.self_attn.v_proj.weight"]  # (num_kv_heads*head_dim, hidden)
            qkv = torch.cat([qw, kw, vw], dim=0).T.contiguous()  # (hidden, (nh+2*nkv)*hd)
            self.w_qkv.append(
                ttnn.from_torch(qkv, dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)
            )
