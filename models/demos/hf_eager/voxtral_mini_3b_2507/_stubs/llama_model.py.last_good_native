        self.ln_input = []
        self.ln_post = []
        for i in range(self.num_layers):
            self.ln_input.append(
                ttnn.from_torch(
                    sd[f"layers.{i}.input_layernorm.weight"].reshape(1, 1, 1, -1),
                    dtype=ttnn.float32,
                    layout=ttnn.TILE_LAYOUT,
                    device=device,
                )
            )
            self.ln_post.append(
                ttnn.from_torch(
                    sd[f"layers.{i}.post_attention_layernorm.weight"].reshape(1, 1, 1, -1),
