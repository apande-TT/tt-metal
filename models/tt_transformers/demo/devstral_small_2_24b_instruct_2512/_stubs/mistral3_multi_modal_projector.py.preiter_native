"""Native tensor-parallel TTNN port of `mistral3_multi_modal_projector` (Mistral3MultiModalProjector,
`multi_modal_projector`) of `mistralai/Devstral-Small-2-24B-Instruct-2512`.

    x   = norm(image_features)                               (RMSNorm over vision hidden 1024)
    x   = merging_layer(unfold_2x2(x per image))             (patch merger: 4*1024 -> 1024)
    out = linear_2(gelu(linear_1(x)))                        (1024 -> 5120 -> 5120)

The 2x2 unfold is a device reshape/permute: per image the (h*w, d) tokens become (h/2, 2, w/2, 2d),
permuted to (h/2, w/2, 2, 2d) and flattened to (h*w/4, 4d) in (row a, col b, channel c) order. torch's
unfold flattens in (c, a, b) order, so the merging weight's input columns are permuted once at build
to match — the math is unchanged.

Tensor-parallel over the mesh (TP = number of devices; TP = 1 on a single device):
  * linear_1  column-parallel on the text hidden dim (gelu stays per-device).
  * linear_2  row-parallel on the same dim, then all_reduce.
  * norm and the small merging layer are replicated.
"""
from __future__ import annotations

import torch
import ttnn


def _mesh_size(device):
    try:
        return int(device.get_num_devices())
    except Exception:
        return 1


class TtMistral3MultiModalProjector:
    def __init__(self, device, torch_module) -> None:
        self.device = device
        self.tp = tp = _mesh_size(device)
        merger = torch_module.patch_merger
        self.merge = k = merger.spatial_merge_size
        self.patch_size = merger.patch_size
        self.eps = float(torch_module.norm.variance_epsilon)
        d = torch_module.norm.weight.shape[0]
        self.d = d
        text_hidden = torch_module.linear_1.weight.shape[0]
        assert text_hidden % tp == 0, f"text hidden {text_hidden} not divisible by TP={tp}"

        is_mesh = tp > 1
        shard = lambda dim: ttnn.ShardTensorToMesh(device, dim=dim) if is_mesh else None
        self._repl = repl = ttnn.ReplicateTensorToMesh(device) if is_mesh else None

        def _put(t, mapper):
            return ttnn.from_torch(
                t.detach().to(torch.bfloat16).contiguous(),
                dtype=ttnn.bfloat16,
                layout=ttnn.TILE_LAYOUT,
                device=device,
                mesh_mapper=mapper,
                memory_config=ttnn.DRAM_MEMORY_CONFIG,
            )

        self.norm_w = _put(torch_module.norm.weight.reshape(1, 1, 1, d), repl)
        # unfold order (c, a, b) -> device order (a, b, c)
        wm = merger.merging_layer.weight.detach()  # (d, d*k*k)
        wm = wm.view(d, d, k, k).permute(0, 2, 3, 1).reshape(d, k * k * d)
        self.w_merge = _put(wm.T, repl)
        self.w1 = _put(torch_module.linear_1.weight.T, shard(-1))
        self.w2 = _put(torch_module.linear_2.weight.T, shard(-2))
        b1, b2 = torch_module.linear_1.bias, torch_module.linear_2.bias
        self.b1 = _put(b1.reshape(1, 1, 1, -1), shard(-1)) if b1 is not None else None
        self.b2 = _put(b2.reshape(1, 1, 1, -1), repl) if b2 is not None else None

        self.compute_cfg = ttnn.init_device_compute_kernel_config(
            device.arch(),
            math_fidelity=ttnn.MathFidelity.HiFi4,
            math_approx_mode=False,
            fp32_dest_acc_en=True,
            packer_l1_acc=True,
        )

    @classmethod
    def build(cls, device, torch_module):
        return cls(device, torch_module)

    def _unfold(self, x, h, w):
        """(1, 1, h*w, d) row-major -> (1, 1, h*w/k^2, k^2*d) in (a, b, c) order."""
        k, d = self.merge, self.d
        x = ttnn.reshape(x, (h // k, k, w // k, k * d))
        x = ttnn.permute(x, (0, 2, 1, 3))
        return ttnn.reshape(x, (1, 1, (h // k) * (w // k), k * k * d))

    def __call__(self, image_features, image_sizes=None, **kwargs):
        sizes = image_sizes
        if isinstance(sizes, ttnn.Tensor):
            sizes = ttnn.to_torch(sizes, mesh_composer=ttnn.ConcatMeshToTensor(self.device, dim=0))[: sizes.shape[0]]
        grids = [(int(hh) // self.patch_size, int(ww) // self.patch_size) for hh, ww in sizes.tolist()]

        x = image_features
        n = x.shape[-2]
        x = ttnn.reshape(x, (1, 1, n, self.d))
        x = ttnn.rms_norm(x, epsilon=self.eps, weight=self.norm_w, compute_kernel_config=self.compute_cfg)
        x = ttnn.to_layout(x, ttnn.ROW_MAJOR_LAYOUT)

        merged, start = [], 0
        for h, w in grids:
            tok = ttnn.slice(x, (0, 0, start, 0), (1, 1, start + h * w, self.d))
            merged.append(self._unfold(tok, h, w))
            start += h * w
        x = merged[0] if len(merged) == 1 else ttnn.concat(merged, dim=2)
        x = ttnn.to_layout(x, ttnn.TILE_LAYOUT)
        x = ttnn.linear(x, self.w_merge, compute_kernel_config=self.compute_cfg)

        hdn = ttnn.linear(x, self.w1, bias=self.b1, compute_kernel_config=self.compute_cfg)
        hdn = ttnn.gelu(hdn, fast_and_approximate_mode=False)
        out = ttnn.linear(hdn, self.w2, compute_kernel_config=self.compute_cfg)
        if self.tp > 1:
            out = ttnn.all_reduce(out, topology=ttnn.Topology.Linear)
        if self.b2 is not None:
            out = ttnn.add(out, self.b2)
        m = out.shape[-2]
        return ttnn.reshape(out, (m, out.shape[-1]))


def build(device, torch_module=None):
    return TtMistral3MultiModalProjector.build(device, torch_module)


def mistral3_multi_modal_projector(device, torch_module=None):
    return TtMistral3MultiModalProjector.build(device, torch_module)
