"""Native tensor-parallel TTNN port of `ministral3_model` (Ministral3Model, `language_model`)
of `mistralai/Devstral-Small-2-24B-Instruct-2512` — prefill, no KV cache.

    h   = embed_tokens(input_ids)
    h   = layer_i(h, causal mask, rope(pos), pos)     for i in 0..39
    out = norm(h)

Tensor-parallel over the mesh (TP = number of devices; TP = 1 on a single device):
  * decoder layers  the TP port from `ministral3_decoder_layer.py` (attention heads / MLP intermediate
                    column-parallel, o_proj / down row-parallel + all_reduce), so the residual stream
                    between layers is full-width and replicated on every device.
  * embed_tokens, final norm, rotary tables and the llama-4 position tensor are replicated.

The rotary tables (yarn: inv_freq and attention_scaling from the checkpoint's rotary_emb) are built
once for `max_seq_len` positions, the way tt_transformers' RotarySetup does, and sliced per call.
"""
from __future__ import annotations

import torch
import ttnn

from models.tt_transformers.demo.devstral_small_2_24b_instruct_2512._stubs.ministral3_decoder_layer import (
    TtMinistral3DecoderLayer,
)


class TtMinistral3Model:
    def __init__(self, device, torch_module, max_seq_len: int = 8192) -> None:
        self.device = device
        cfg = torch_module.config
        self.layers = [
            TtMinistral3DecoderLayer(device, layer) for layer in torch_module.layers[: cfg.num_hidden_layers]
        ]
        self.tp = self.layers[0].tp
        self.head_dim = self.layers[0].attn.head_dim
        self.eps = float(torch_module.norm.variance_epsilon)
        self.max_seq_len = max_seq_len
        self._repl = repl = ttnn.ReplicateTensorToMesh(device) if self.tp > 1 else None

        def _put(t, layout=ttnn.TILE_LAYOUT, dtype=ttnn.bfloat16):
            return ttnn.from_torch(
                t.detach().contiguous(),
                dtype=dtype,
                layout=layout,
                device=device,
                mesh_mapper=repl,
                memory_config=ttnn.DRAM_MEMORY_CONFIG,
            )

        self.embed_w = _put(torch_module.embed_tokens.weight.to(torch.bfloat16), layout=ttnn.ROW_MAJOR_LAYOUT)
        hidden = torch_module.norm.weight.shape[0]
        self.norm_w = _put(torch_module.norm.weight.to(torch.bfloat16).reshape(1, 1, 1, hidden))

        rotary = torch_module.rotary_emb
        inv_freq = rotary.inv_freq.detach().float()
        freqs = torch.outer(torch.arange(max_seq_len, dtype=torch.float32), inv_freq)
        emb = torch.cat((freqs, freqs), dim=-1)
        scaling = float(rotary.attention_scaling)
        self.cos = _put((emb.cos() * scaling).to(torch.bfloat16).reshape(1, 1, max_seq_len, self.head_dim))
        self.sin = _put((emb.sin() * scaling).to(torch.bfloat16).reshape(1, 1, max_seq_len, self.head_dim))
        self.pos = _put(
            torch.arange(max_seq_len, dtype=torch.float32).reshape(1, 1, max_seq_len, 1), dtype=ttnn.float32
        )
        self.compute_cfg = self.layers[0].compute_cfg

    @classmethod
    def build(cls, device, torch_module):
        return cls(device, torch_module)

    def __call__(self, input_ids, attention_mask=None, position_ids=None, **kwargs):
        ids = input_ids
        if isinstance(ids, torch.Tensor):
            ids = ttnn.from_torch(
                ids.to(torch.int32), dtype=ttnn.uint32, device=self.device, mesh_mapper=self._repl
            )
        s = ids.shape[-1]
        assert s <= self.max_seq_len and s % 32 == 0, f"seq {s} must be a tile multiple <= {self.max_seq_len}"
        if isinstance(attention_mask, torch.Tensor):
            assert bool((attention_mask != 0).all()), "padded prompts are not supported by this prefill port"
        if isinstance(position_ids, torch.Tensor):
            expected = torch.arange(s, dtype=position_ids.dtype).expand_as(position_ids)
            assert torch.equal(position_ids, expected), "prefill port expects positions 0..S-1"

        hd = self.head_dim
        cos = ttnn.slice(self.cos, (0, 0, 0, 0), (1, 1, s, hd))
        sin = ttnn.slice(self.sin, (0, 0, 0, 0), (1, 1, s, hd))
        pos = ttnn.slice(self.pos, (0, 0, 0, 0), (1, 1, s, 1))

        x = ttnn.embedding(ttnn.reshape(ids, (1, s)), self.embed_w, layout=ttnn.TILE_LAYOUT)
        x = ttnn.reshape(x, (1, 1, s, x.shape[-1]))
        for layer in self.layers:
            # attention_mask=None -> causal SDPA, the mask HF builds for an unpadded prompt.
            x = layer(x, attention_mask=None, position_ids=pos, position_embeddings=(cos, sin))
            x = ttnn.reshape(x, (1, 1, s, x.shape[-1]))
        out = ttnn.rms_norm(x, epsilon=self.eps, weight=self.norm_w, compute_kernel_config=self.compute_cfg)
        return ttnn.reshape(out, (1, s, out.shape[-1]))


def build(device, torch_module=None):
    return TtMinistral3Model.build(device, torch_module)


def ministral3_model(device, torch_module=None):
    return TtMinistral3Model.build(device, torch_module)
