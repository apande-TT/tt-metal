"""Native tensor-parallel TTNN port of `ministral3_decoder_layer` (Ministral3DecoderLayer,
`language_model.layers.0`) of `mistralai/Devstral-Small-2-24B-Instruct-2512`.

    h   = x + self_attn(input_layernorm(x))
    out = h + down(silu(gate(n)) * up(n))        with n = post_attention_layernorm(h)

Tensor-parallel over the mesh (TP = number of devices; TP = 1 on a single device):
  * self_attn  the TP port from `ministral3_attention.py` (q/k/v column-parallel by head with GQA groups
               kept local, o_proj row-parallel + all_reduce).
  * gate/up    column-parallel on the intermediate dim.
  * down_proj  row-parallel on the intermediate dim, then all_reduce.
  * norms are replicated, so the residual stream is full-width and replicated on every device.
"""
from __future__ import annotations

import torch
import ttnn

from models.tt_transformers.demo.devstral_small_2_24b_instruct_2512._stubs.ministral3_attention import (
    TtMinistral3Attention,
)


class TtMinistral3DecoderLayer:
    def __init__(self, device, torch_module) -> None:
        self.device = device
        self.attn = TtMinistral3Attention(device, torch_module.self_attn)
        self.tp = tp = self.attn.tp
        self.eps_in = float(torch_module.input_layernorm.variance_epsilon)
        self.eps_post = float(torch_module.post_attention_layernorm.variance_epsilon)

        is_mesh = tp > 1
        shard = lambda dim: ttnn.ShardTensorToMesh(device, dim=dim) if is_mesh else None
        repl = ttnn.ReplicateTensorToMesh(device) if is_mesh else None

        def _put(t, mapper):
            return ttnn.from_torch(
                t.detach().to(torch.bfloat16).contiguous(),
                dtype=ttnn.bfloat16,
                layout=ttnn.TILE_LAYOUT,
                device=device,
                mesh_mapper=mapper,
                memory_config=ttnn.DRAM_MEMORY_CONFIG,
            )

        mlp = torch_module.mlp
        assert mlp.intermediate_size % tp == 0, f"intermediate {mlp.intermediate_size} not divisible by TP={tp}"
        self.w_gate = _put(mlp.gate_proj.weight.T, shard(-1))
        self.w_up = _put(mlp.up_proj.weight.T, shard(-1))
        self.w_down = _put(mlp.down_proj.weight.T, shard(-2))

        hidden = torch_module.input_layernorm.weight.shape[0]
        self.in_norm_w = _put(torch_module.input_layernorm.weight.reshape(1, 1, 1, hidden), repl)
        self.post_norm_w = _put(torch_module.post_attention_layernorm.weight.reshape(1, 1, 1, hidden), repl)
        self.compute_cfg = self.attn.compute_cfg

    @classmethod
    def build(cls, device, torch_module):
        return cls(device, torch_module)

    def _reduce(self, t):
        if self.tp == 1:
            return t
        return ttnn.all_reduce(t, topology=ttnn.Topology.Linear)

    def __call__(self, hidden_states, attention_mask=None, position_ids=None, position_embeddings=None, **kwargs):
        x = hidden_states
        if len(x.shape) == 3:
            x = ttnn.reshape(x, (1, x.shape[0], x.shape[1], x.shape[2]))
        _, b, s, _ = x.shape

        # --- self attention ---
        n = ttnn.rms_norm(x, epsilon=self.eps_in, weight=self.in_norm_w, compute_kernel_config=self.compute_cfg)
        a = self.attn(
            n,
            position_embeddings=position_embeddings,
            attention_mask=attention_mask,
            position_ids=position_ids,
        )
        h = ttnn.add(x, ttnn.reshape(a, (1, b, s, a.shape[-1])))

        # --- feed-forward ---
        n = ttnn.rms_norm(h, epsilon=self.eps_post, weight=self.post_norm_w, compute_kernel_config=self.compute_cfg)
        g = ttnn.linear(n, self.w_gate, compute_kernel_config=self.compute_cfg)
        u = ttnn.linear(n, self.w_up, compute_kernel_config=self.compute_cfg)
        m = ttnn.multiply(ttnn.silu(g), u)
        d = self._reduce(ttnn.linear(m, self.w_down, compute_kernel_config=self.compute_cfg))
        out = ttnn.add(h, d)
        return ttnn.reshape(out, (b, s, out.shape[-1]))


def build(device, torch_module=None):
    return TtMinistral3DecoderLayer.build(device, torch_module)


def ministral3_decoder_layer(device, torch_module=None):
    return TtMinistral3DecoderLayer.build(device, torch_module)
