flowchart TB
    subgraph LEGEND["Legend — runtime role"]
        direction LR
        L0["Gray: raw user inputs"]
        L3["Blue: host glue once or per-step scheduler negligible time"]
        L1["Green: TTNN compute traced plus 2CQ where noted"]
        L2["Yellow: TTNN scaffold runs but PCC not validated"]
        L4["Red: not wired in live ACE-Step e2e today"]
        L5["Purple: Phase A host fallback working today"]
    end

    subgraph USER["User inputs live path target"]
        CAP["Caption prompt<br/>IN: text OUT: strings"]
        LYR["Lyrics<br/>IN: text OUT: strings"]
        REF["Reference audio cover mode<br/>IN: WAV 48kHz OUT: PCM"]
    end

    subgraph PREFLIGHT["Preflight host once per generation — blue glue"]
        direction TB
        TE["Qwen3-Embedding-0.6B<br/>IN: caption lyrics OUT: text_hidden lyric_hidden<br/>STATUS: tt_transformers exists NOT wired live"]
        VAE_ENC["Oobleck VAE encoder<br/>IN: PCM OUT: refer_audio B,T,64<br/>STATUS: NOT on TT in e2e"]
        BUILD["build_inputs today<br/>IN: _captured tensors OUT: TH LH REFH src_latents masks<br/>NOTE: prompts ignored until live preflight wired"]
        B0["tokenize_preprocess einops<br/>IN: src_latents OUT: patches B0 host only"]
    end

    CAP --> TE
    LYR --> TE
    REF --> VAE_ENC
    TE --> TH["text_hidden B,T,1024"]
    TE --> LH["lyric_hidden B,T,1024"]
    VAE_ENC --> REFH["refer_audio B,T,64"]
    BUILD --> TH
    BUILD --> LH
    BUILD --> REFH
    BUILD --> SRC["src_latents B,T,64"]
    BUILD --> MASK["chunk_masks B,T,64"]
    SRC --> B0

    subgraph HOT["Hot path TTNN — trace plus 2CQ replay bulk of wall time"]
        direction TB

        subgraph TRACE_A["Call A TracedConditionEncoder2CQ green"]
            A1["text projector"]
            A2["Lyric encoder 8L"]
            A3["Timbre encoder 4L"]
            A4["pack sequences"]
        end

        subgraph TRACE_BD["Call B plus D TracedAudioPath2CQ green 2CQ overlaps with A"]
            POOL["Attention pooler plus FSQ"]
            DET["AudioTokenDetokenizer"]
        end

        subgraph GLUE_ONCE["Host glue once after prefill blue"]
            MERGE["assemble_context where is_cover"]
            CTX["context_latents B,T,128 bound into decoder trace"]
            NOISE["prepare_noise"]
        end

        subgraph TRACE_C["Call C TracedDecoder2CQ green per ODE step"]
            C2["24x DiT layer IN xt t encoder context OUT vt"]
        end

        subgraph LOOP["ODE scheduler host blue per step tiny"]
            EULER["xt = xt minus vt times dt"]
        end
    end

    TH --> A1
    LH --> A2
    REFH --> A3
    A1 --> A4
    A2 --> A4
    A3 --> A4
    A4 --> ENC["encoder_hidden B,109,2048 device resident with 2CQ"]

    B0 --> POOL
    POOL --> DET
    DET --> LM25["lm_hints_25Hz B,T,64"]
    LM25 --> MERGE
    SRC --> MERGE
    MASK --> MERGE
    MERGE --> CTX
    CTX --> NOISE
    NOISE --> XT["xt noise B,T,64"]

    ENC --> TRACE_C
    CTX --> TRACE_C
    XT --> TRACE_C
    TRACE_C --> VT["velocity vt B,T,64"]
    VT --> EULER
    EULER --> XT
    EULER --> TL["target_latents B,T,64 OUT of loop"]

    subgraph OPTIONAL["Optional production extras — red not in v0 e2e"]
        LM["acestep-5Hz-lm planner"]
        CFG["CFG 2x DiT forward per step"]
        APG["APG ADG guidance"]
    end

    LM -.-> LM25
    CFG -.-> TRACE_C
    APG -.-> EULER

    subgraph POST["Post decode latents to WAV"]
        TPOSE["transpose B,T,64 to B,64,T host glue"]
        DEC_HOST["Oobleck decoder host Phase A DONE"]
        DEC_TT["Oobleck decoder TT Phase B SCAFFOLD PCC pending"]
        NORM["peak normalize host"]
    end

    TL --> TPOSE
    TPOSE --> DEC_HOST
    TPOSE --> DEC_TT
    DEC_HOST --> NORM
    DEC_TT --> NORM
    NORM --> WAV["stereo WAV 48kHz listenable music"]

    subgraph PERF["Performance context 2026-07-03"]
        P1["Gate config infer_steps=4 captured inputs cover mode"]
        P2["P150 trace plus 2CQ latents only about 0.19s at 4 steps"]
        P3["Production about 30 ODE steps plus CFG doubles DiT per step"]
        P4["Nvidia A100 full stack text plus ref audio to WAV under 2s reference"]
        P5["TT target full A-Z traced under 2s after live preflight plus TT VAE plus prod steps"]
    end

    classDef rawInput fill:#9e9e9e,stroke:#616161,color:#ffffff
    classDef hostGlue fill:#457b9d,stroke:#1d3557,color:#ffffff
    classDef ttnnDone fill:#2d6a4f,stroke:#1b4332,color:#ffffff
    classDef ttnnPart fill:#e9c46a,stroke:#b8860b,color:#1a1a1a
    classDef notWired fill:#e76f51,stroke:#c44536,color:#ffffff
    classDef hostDone fill:#7b2cbf,stroke:#5a189a,color:#ffffff
    classDef perfNote fill:#f4f4f4,stroke:#888888,color:#333333

    class CAP,LYR,REF rawInput
    class BUILD,TH,LH,REFH,SRC,MASK,B0,MERGE,CTX,NOISE,XT,EULER,TPOSE,NORM,WAV hostGlue
    class A1,A2,A3,A4,ENC,POOL,DET,LM25,C2,VT,TL,TRACE_A,TRACE_BD,TRACE_C ttnnDone
    class DEC_TT ttnnPart
    class TE,VAE_ENC,LM,CFG,APG notWired
    class DEC_HOST hostDone
    class P1,P2,P3,P4,P5 perfNote
    class L0 rawInput
    class L3 hostGlue
    class L1 ttnnDone
    class L2 ttnnPart
    class L4 notWired
    class L5 hostDone
